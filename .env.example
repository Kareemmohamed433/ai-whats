# --- NEXORA AI CUSTOMER SERVICE PLATFORM CONFIGURATION ---

# Environment & Server
FLASK_ENV=production
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/nexora_db
# For SQLite local development fallback, leave DATABASE_URL unset:
# DATABASE_URL=

# NEXORA Official References
NEXORA_PORTFOLIO_URL=https://company-pi-two.vercel.app/
NEXORA_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61595024167397
NEXORA_INSTAGRAM_URL=https://www.instagram.com/nexorasoftwarre/
TELEGRAM_SERVICE_URL=https://ai-whats-production.up.railway.app/

# Security Secrets (Must be changed in production)
SECRET_KEY=nexora-production-secret-key-change-this-in-production-2026
JWT_SECRET_KEY=nexora-jwt-production-secret-key-change-this-in-production-2026

# AI Provider Configuration (Groq, OpenAI, or compatible endpoint)
AI_API_KEY=your_openai_or_groq_api_key_here
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=500

# WhatsApp Business Cloud API Credentials
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=nexora_verify_token_2026
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# Meta Instagram Direct Graph API Credentials
INSTAGRAM_ACCESS_TOKEN=your_instagram_page_access_token_here
INSTAGRAM_VERIFY_TOKEN=nexora_instagram_verify_2026
INSTAGRAM_ACCOUNT_ID=17841422010205813
INSTAGRAM_PAGE_ID=your_instagram_page_id_here

# TikTok Business Messaging API Credentials (Unavailable/Optional)
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_APP_ID=your_tiktok_app_id_here

# Telegram Bot API Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather_here

# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# Web Push (VAPID) Notifications (RFC 8292)
# Generate with: python backend/generate_vapid_keys.py
VAPID_PUBLIC_KEY=your_vapid_public_key_base64url_here
VAPID_PRIVATE_KEY=your_vapid_private_key_base64url_here
VAPID_CLAIM_EMAIL=mailto:contact@nexorasolutions.com
