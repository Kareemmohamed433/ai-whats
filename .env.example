# --- KHAMS SINAA AI CUSTOMER SERVICE DASHBOARD CONFIGURATION ---

# Environment & Database Setup
FLASK_ENV=production
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/khams_sinaa_db
# For SQLite local fallback, leave DATABASE_URL blank or unset

# Security Secrets
SECRET_KEY=khams-sinaa-super-secret-key-change-this-in-production-2026
JWT_SECRET_KEY=khams-sinaa-jwt-secret-key-change-this-in-production-2026

# AI Provider Configuration (OpenAI, Groq, Anthropic, Gemini Compatible)
AI_API_KEY=your_openai_or_groq_api_key_here
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=500

# WhatsApp Business Cloud API Credentials
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=khams_sinaa_verify_token_2026
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# Meta Instagram Messaging API Credentials
INSTAGRAM_ACCESS_TOKEN=your_instagram_page_access_token_here
INSTAGRAM_PAGE_ID=your_instagram_page_id_here

# TikTok Business Messaging API Credentials
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_APP_ID=your_tiktok_app_id_here

# Telegram Bot API Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather_here

# Frontend Application URL
FRONTEND_URL=http://localhost:5173
